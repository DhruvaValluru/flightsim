# Shell scripts must stay LF: a CRLF-mangled setup.sh is the classic
# first-clone failure on Windows.
*.sh text eol=lf
*.ps1 text eol=crlf
# Sane text defaults; binary artifacts stay untouched.
* text=auto
*.png binary
*.jpg binary
*.mp4 binary
*.r16 binary
*.pgm binary
*.tif binary
*.ttc binary
*.ttf binary

# Files whose bytes a recorded sha256 or a hash contract covers stay exactly
# as committed on every platform (a CRLF checkout under text=auto broke the
# NWP fixture digests and the derivation hash pins on the Windows runner at
# ec655e2, measured): the vendored JSBSim data and our injected templates
# (the derived airframe's hash is checked at the host's door), the cached
# weather fixtures with their provenance sidecars, and the entity table.
ue/Plugins/JSBSimFlightDynamicsModel/Resources/JSBSim/** -text
core/control/systems/** -text
assets/nwp/** -text
assets/dis_entity_types.yaml -text
# S3: the IR proxy's cached emissivity rows and transmittance tables, whose
# bytes their .sha256 sidecars and provenance records cover.
assets/emissivity/** -text
assets/thermal/** -text
# The GLO-30 land mask, whose bytes its sidecar's mask_sha256 covers.
assets/landmask/** -text
# A-4 visual model (MSFS/P3D) -- must never be text-normalised
*.mdl binary
*.dds binary

# A4: the stamp-tree fixture keeps its CRLF (Get-PluginSourceHash must see one).
tests/fixtures/stamp_tree/** -text

# Phase 3 event logs are append-only JSONL written by two machines and many
# agents: a union merge is always the right answer (measured 2026-11-04: every
# pull conflict on these files was two appends to the same tail).
docs/phase3/events_mac.log merge=union
docs/phase3/events_windows.log merge=union
tests/fixtures/engine_bundle_min/cited/** -text
*.cmd text eol=crlf

# D2: the vendored J-11A's hashes and licence text stay byte-exact on Windows.
assets/fdm_root/aircraft/J11/** -text
docs/phase3/packets/D1-SU-27SK-LICENSE.txt -text
