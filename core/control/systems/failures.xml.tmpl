    <actuator name="failure/@SURFACE@/actuator">
      <input>failure/@SURFACE@/scaled</input>
      <clipto>
        <min>-1</min>
        <max>1</max>
      </clipto>
      <output>failure/@SURFACE@/cmd-in</output>
    </actuator>
  </channel>
SURFACE_CHANNEL-->
