{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/DhruvaValluru/flightsim/docs/schemas/capture_manifest.v7.schema.json",
 "title": "flightsim capture manifest, version 7",
 "description": "capture_manifest.json as written by core/capture/manifest.py (manifest_version 7). One record per frame: camera pose, intrinsics, projection matrix, aircraft state, labels and the sensor model; per run: digests, seed, scene, airframe, conventions, asset digests and the randomisation block. Positions are local scene metres (north, east, up) about the run's projected origin; the camera frame is x right, y down, z forward; pixel = (P p) / (P p)_z. Validate before parsing; a consumer must not guess at a key it does not find here. Version 6 (Phase 2, packages B + C): a top-level objects[] (every labelled object with its stable id and 8-bit int_id, composed once from the spec), taxonomy (the ordered class list, class_id = position + 1), traffic[] (each scripted traffic aircraft's provenance), and per frame labels.objects[] (one record per labelled object; the engine-derived keys bbox_2d_tight, visible_fraction, occluded_by, depth_min_m, depth_median_m are null with a basis until the render bundle is attached). Version 7 (INT-final, the advancement addition's one bump): every block the addition wrote as an optional, absent-canonical key is declared here, each still OPTIONAL (a manifest carrying none of them is a version-6 manifest with this number changed) and each accepting null (a frame sidecar carries null for a block its run did not write): datum, applied_variables at record 2 (the structured model block is 'model', the one-line name 'model_name'), uncertainty (ASME V&V 20), instruments (the FDM-rate observer), null_tests, look (night, precipitation, cloud drift), landcover (the WorldCover legend), licences[], scene.buildings / scene.runway, per camera sensing and stereo, per frame radiometry, passes, ir, dis and labels.landcover, the aggregate object ids building:all and vegetation:all, and state_units values drawn from the recorder's suffix table and the variable registry (the new suffixes _kgm3, _kgm2, _mps2, _rads, _flag, _hpa, _pct, _m2_s, _rpm, _ut, _k among them). scene.land_cover, frame.vertical_datum and interop.dis are the blueprint's spellings, declared optional; no producer of this build writes them (the land cover rides in landcover, the vertical datum in datum, the DIS record in applied_variables and each frame's dis).",
 "type": "object",
 "required": [
  "manifest_version",
  "spec_digest",
  "simulation_digest",
  "output_digest",
  "solve_source",
  "seed",
  "aircraft",
  "scene",
  "frame",
  "software_revision",
  "landmarks",
  "conditions",
  "state_units",
  "airframe",
  "label_conventions",
  "assets",
  "randomization",
  "cameras",
  "frames",
  "objects",
  "taxonomy",
  "traffic"
 ],
 "properties": {
  "manifest_version": {
   "type": "integer",
   "const": 7
  },
  "spec_digest": {
   "$ref": "#/$defs/sha256"
  },
  "simulation_digest": {
   "$ref": "#/$defs/sha256"
  },
  "output_digest": {
   "type": "string"
  },
  "solve_source": {
   "type": "string"
  },
  "seed": {
   "type": "integer",
   "minimum": 0
  },
  "aircraft": {
   "type": "string"
  },
  "scene": {
   "type": "object",
   "required": [
    "key",
    "terrain",
    "terrain_sha256"
   ],
   "properties": {
    "key": {
     "type": "string"
    },
    "terrain": {
     "type": [
      "string",
      "null"
     ]
    },
    "terrain_sha256": {
     "type": [
      "string",
      "null"
     ]
    },
    "buildings": {
     "anyOf": [
      {
       "type": "object",
       "required": [
        "key",
        "file",
        "sha256",
        "licence",
        "count",
        "document",
        "document_sha256",
        "object_id"
       ],
       "properties": {
        "key": {
         "type": "string"
        },
        "count": {
         "type": "integer",
         "minimum": 0
        },
        "document_sha256": {
         "anyOf": [
          {
           "$ref": "#/$defs/sha256"
          },
          {
           "type": "null"
          }
         ]
        },
        "object_id": {
         "type": "string",
         "const": "building:all"
        }
       }
      },
      {
       "type": "null"
      }
     ]
    },
    "runway": {
     "anyOf": [
      {
       "type": "object",
       "required": [
        "designator",
        "pad",
        "pad_sha256",
        "parent_sha256",
        "document",
        "document_sha256",
        "markings",
        "markings_sha256"
       ],
       "properties": {
        "designator": {
         "type": "string"
        },
        "document_sha256": {
         "anyOf": [
          {
           "$ref": "#/$defs/sha256"
          },
          {
           "type": "null"
          }
         ]
        }
       }
      },
      {
       "type": "null"
      }
     ]
    },
    "land_cover": {
     "anyOf": [
      {
       "type": "object"
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "frame": {
   "type": "object",
   "properties": {
    "crs": {
     "type": [
      "string",
      "null"
     ]
    },
    "vertical_datum": {
     "anyOf": [
      {
       "type": [
        "string",
        "object"
       ]
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "software_revision": {
   "type": "string"
  },
  "landmarks": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "north_m",
     "east_m",
     "alt_m"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "north_m": {
      "type": "number"
     },
     "east_m": {
      "type": "number"
     },
     "alt_m": {
      "type": "number"
     }
    }
   }
  },
  "conditions": {
   "type": "object"
  },
  "state_units": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/unit"
   }
  },
  "airframe": {
   "type": "object",
   "required": [
    "aircraft",
    "length_m",
    "span_m",
    "height_m",
    "keypoints"
   ],
   "properties": {
    "aircraft": {
     "type": "string"
    },
    "length_m": {
     "type": "number",
     "minimum": 0
    },
    "span_m": {
     "type": "number",
     "minimum": 0
    },
    "height_m": {
     "type": "number",
     "minimum": 0
    },
    "keypoints": {
     "type": "array"
    }
   }
  },
  "label_conventions": {
   "type": "object"
  },
  "assets": {
   "type": "object"
  },
  "randomization": {
   "type": [
    "object",
    "null"
   ]
  },
  "cameras": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/camera_block"
   }
  },
  "frames": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/frame_record"
   }
  },
  "objects": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/scene_object"
   }
  },
  "taxonomy": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   }
  },
  "traffic": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/traffic_block"
   }
  },
  "datum": {
   "anyOf": [
    {
     "type": "object",
     "required": [
      "vertical_datum_of_heights",
      "geoid_model",
      "undulation_m"
     ],
     "properties": {
      "vertical_datum_of_heights": {
       "type": "string"
      },
      "geoid_model": {
       "type": [
        "string",
        "null"
       ]
      },
      "undulation_m": {
       "type": [
        "number",
        "null"
       ]
      }
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "applied_variables": {
   "anyOf": [
    {
     "type": "object",
     "required": [
      "record_version",
      "applied_variables"
     ],
     "properties": {
      "record_version": {
       "type": "integer",
       "const": 2
      },
      "applied_variables": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/applied_variable"
       }
      }
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "uncertainty": {
   "anyOf": [
    {
     "type": "object",
     "required": [
      "u_num",
      "u_input",
      "u_val",
      "form",
      "not_claimed"
     ],
     "properties": {
      "u_num": {
       "type": "object"
      },
      "u_input": {
       "type": "object"
      },
      "u_val": {
       "type": "object"
      },
      "form": {
       "type": "string"
      },
      "not_claimed": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "instruments": {
   "anyOf": [
    {
     "type": "object",
     "required": [
      "instruments_version",
      "rate_basis",
      "instruments",
      "profiles",
      "file",
      "sha256",
      "columns",
      "not_claimed"
     ],
     "properties": {
      "instruments_version": {
       "type": "integer",
       "minimum": 1
      },
      "rate_basis": {
       "type": "string"
      },
      "instruments": {
       "type": "object"
      },
      "profiles": {
       "type": "object"
      },
      "file": {
       "type": [
        "string",
        "null"
       ]
      },
      "sha256": {
       "anyOf": [
        {
         "$ref": "#/$defs/sha256"
        },
        {
         "type": "null"
        }
       ]
      },
      "columns": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "not_claimed": {
       "type": "array"
      }
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "null_tests": {
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": [
       "variable",
       "spec_path",
       "digests",
       "effect",
       "verdict"
      ],
      "properties": {
       "variable": {
        "type": "string"
       },
       "spec_path": {
        "type": "string"
       },
       "digests": {
        "type": "object"
       },
       "effect": {
        "type": "object"
       },
       "verdict": {
        "type": "string",
        "enum": [
         "reached",
         "silent",
         "ungraded"
        ]
       }
      }
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "look": {
   "anyOf": [
    {
     "type": "object",
     "required": [
      "cloud_drift"
     ],
     "properties": {
      "night": {
       "anyOf": [
        {
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "precipitation": {
       "anyOf": [
        {
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "cloud_drift": {
       "type": "object"
      },
      "night_sky": {
       "anyOf": [
        {
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      }
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "landcover": {
   "anyOf": [
    {
     "type": "object",
     "required": [
      "dataset",
      "legend",
      "nodata",
      "class_map",
      "grid",
      "image"
     ],
     "properties": {
      "dataset": {},
      "legend": {
       "type": [
        "object",
        "array"
       ]
      },
      "nodata": {
       "type": "integer"
      },
      "class_map": {
       "type": "object"
      },
      "grid": {
       "type": "object"
      },
      "image": {
       "type": "object"
      }
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "licences": {
   "anyOf": [
    {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "asset",
       "kind",
       "licence",
       "spdx",
       "ml_use",
       "reaches"
      ],
      "properties": {
       "asset": {
        "type": "string"
       },
       "kind": {
        "type": "string"
       },
       "licence": {
        "type": [
         "string",
         "null"
        ]
       },
       "spdx": {
        "type": [
         "string",
         "null"
        ]
       },
       "ml_use": {
        "type": "string"
       },
       "reaches": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "sha256": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    },
    {
     "type": "null"
    }
   ]
  },
  "interop": {
   "anyOf": [
    {
     "type": "object",
     "properties": {
      "dis": {
       "anyOf": [
        {
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      }
     }
    },
    {
     "type": "null"
    }
   ]
  }
 },
 "$defs": {
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "vec3": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3,
   "items": {
    "type": "number"
   }
  },
  "matrix3x3": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3,
   "items": {
    "$ref": "#/$defs/vec3"
   }
  },
  "matrix3x4": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3,
   "items": {
    "type": "array",
    "minItems": 4,
    "maxItems": 4,
    "items": {
     "type": "number"
    }
   }
  },
  "camera_block": {
   "type": "object",
   "required": [
    "camera_id",
    "preset",
    "horizon_stable",
    "inherits_roll",
    "schedule_basis",
    "trigger",
    "capture_count",
    "pose_track_digest",
    "profile"
   ],
   "properties": {
    "camera_id": {
     "type": "string"
    },
    "preset": {
     "type": "string"
    },
    "horizon_stable": {
     "type": "boolean"
    },
    "inherits_roll": {
     "type": "boolean"
    },
    "spec": {
     "type": [
      "object",
      "null"
     ]
    },
    "schedule_basis": {
     "type": "string"
    },
    "trigger": {
     "type": "string"
    },
    "capture_count": {
     "type": "integer",
     "minimum": 0
    },
    "pose_track_digest": {
     "type": "string"
    },
    "profile": {
     "type": "object"
    },
    "sensing": {
     "anyOf": [
      {
       "type": "object",
       "required": [
        "requested_by"
       ],
       "properties": {
        "requested_by": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "exposure": {
         "anyOf": [
          {
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "radiometry": {
         "anyOf": [
          {
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "bands": {
         "anyOf": [
          {
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "optics": {
         "anyOf": [
          {
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "motion_blur": {
         "anyOf": [
          {
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "ir": {
         "anyOf": [
          {
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "records": {
         "type": "string"
        }
       }
      },
      {
       "type": "null"
      }
     ]
    },
    "stereo": {
     "anyOf": [
      {
       "type": "object",
       "required": [
        "role",
        "left_camera_id",
        "right_camera_id",
        "baseline_m",
        "side"
       ],
       "properties": {
        "role": {
         "type": "string",
         "enum": [
          "left",
          "right"
         ]
        },
        "left_camera_id": {
         "type": "string"
        },
        "right_camera_id": {
         "type": "string"
        },
        "baseline_m": {
         "type": "number",
         "minimum": 0
        },
        "side": {
         "type": "string"
        }
       }
      },
      {
       "type": "null"
      }
     ]
    }
   }
  },
  "frame_record": {
   "type": "object",
   "required": [
    "index",
    "camera_id",
    "file",
    "t_s",
    "sample_index",
    "position_north_m",
    "position_east_m",
    "position_alt_m",
    "quaternion_wxyz",
    "yaw_deg",
    "pitch_deg",
    "roll_deg",
    "focal_length_mm",
    "sensor_width_mm",
    "sensor_height_mm",
    "width_px",
    "height_px",
    "near_m",
    "far_m",
    "principal_point_px",
    "fx_px",
    "fy_px",
    "intrinsic_matrix",
    "projection_matrix",
    "aircraft",
    "state",
    "labels",
    "sensor"
   ],
   "properties": {
    "index": {
     "type": "integer",
     "minimum": 0
    },
    "camera_id": {
     "type": "string"
    },
    "file": {
     "type": "string",
     "pattern": "^frames/.+/frame_[0-9]{4}\\.png$"
    },
    "t_s": {
     "type": "number",
     "minimum": 0
    },
    "sample_index": {
     "type": "integer",
     "minimum": 0
    },
    "position_north_m": {
     "type": "number"
    },
    "position_east_m": {
     "type": "number"
    },
    "position_alt_m": {
     "type": "number"
    },
    "quaternion_wxyz": {
     "type": "array",
     "minItems": 4,
     "maxItems": 4,
     "items": {
      "type": "number"
     }
    },
    "yaw_deg": {
     "type": "number"
    },
    "pitch_deg": {
     "type": "number"
    },
    "roll_deg": {
     "type": "number"
    },
    "focal_length_mm": {
     "type": "number",
     "minimum": 0
    },
    "sensor_width_mm": {
     "type": "number",
     "minimum": 0
    },
    "sensor_height_mm": {
     "type": "number",
     "minimum": 0
    },
    "width_px": {
     "type": "integer",
     "minimum": 1
    },
    "height_px": {
     "type": "integer",
     "minimum": 1
    },
    "near_m": {
     "type": "number",
     "minimum": 0
    },
    "far_m": {
     "type": "number",
     "minimum": 0
    },
    "principal_point_px": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "type": "number"
     }
    },
    "fx_px": {
     "type": "number",
     "minimum": 0
    },
    "fy_px": {
     "type": "number",
     "minimum": 0
    },
    "intrinsic_matrix": {
     "$ref": "#/$defs/matrix3x3"
    },
    "projection_matrix": {
     "$ref": "#/$defs/matrix3x4"
    },
    "aircraft": {
     "type": "object",
     "required": [
      "north_m",
      "east_m",
      "alt_m",
      "roll_deg",
      "pitch_deg",
      "heading_deg"
     ],
     "properties": {
      "north_m": {
       "type": "number"
      },
      "east_m": {
       "type": "number"
      },
      "alt_m": {
       "type": "number"
      },
      "roll_deg": {
       "type": "number"
      },
      "pitch_deg": {
       "type": "number"
      },
      "heading_deg": {
       "type": "number"
      }
     }
    },
    "state": {
     "type": "object"
    },
    "labels": {
     "type": "object",
     "required": [
      "bbox_2d",
      "bbox_2d_unclipped",
      "truncation",
      "in_frame",
      "bbox_3d_camera",
      "keypoints",
      "horizon",
      "objects"
     ],
     "properties": {
      "bbox_2d": {
       "anyOf": [
        {
         "type": "null"
        },
        {
         "type": "array",
         "minItems": 4,
         "maxItems": 4,
         "items": {
          "type": "number"
         }
        }
       ]
      },
      "in_frame": {
       "type": "boolean"
      },
      "keypoints": {
       "type": "object"
      },
      "horizon": {
       "type": "object"
      },
      "objects": {
       "type": "array",
       "minItems": 1,
       "items": {
        "$ref": "#/$defs/object_label"
       }
      },
      "landcover": {
       "anyOf": [
        {
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      }
     }
    },
    "sensor": {
     "type": "object",
     "required": [
      "profile",
      "angular_rate_rad_s",
      "labels_sensor"
     ],
     "properties": {
      "profile": {
       "type": "string"
      },
      "angular_rate_rad_s": {
       "$ref": "#/$defs/vec3"
      },
      "labels_sensor": {
       "type": "object"
